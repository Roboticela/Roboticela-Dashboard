# PostgreSQL connection string for Prisma
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/roboticela?schema=public"

# Cloudflare R2 (for product app icon uploads)
# Create an R2 bucket, enable "Public access" (r2.dev or custom domain), then create API token in R2 Overview.
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="your_bucket_name"
# Public URL for the bucket (e.g. https://pub-xxxx.r2.dev from bucket Settings > Public access, or your custom domain)
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
