generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  buttonName  String   @map("button_name")
  buttonLink  String   @map("button_link")
  buttons     Json?    // [{ name, link }] - multiple buttons; legacy single button kept for backward compat
  appIcon     String?  @map("app_icon")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}

model ProductRequest {
  id              String   @id @default(cuid())
  name            String
  email           String
  company         String?
  productType     String   @map("product_type")
  productDescription String @map("product_description")
  industryUseCase String   @map("industry_use_case")
  priorityLevel   String   @map("priority_level")
  createdAt       DateTime @default(now()) @map("created_at")
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
}

model ContactUs {
  id        String   @id @default(cuid())
  fullName  String   @map("full_name")
  email     String
  message   String
  createdAt DateTime @default(now()) @map("created_at")
}

model Support {
  id          String   @id @default(cuid())
  fullName    String   @map("full_name")
  email       String
  productName String   @map("product_name")
  message     String
  createdAt   DateTime @default(now()) @map("created_at")
}

model Feedback {
  id          String   @id @default(cuid())
  rating      Int
  message     String
  productName String   @map("product_name")
  createdAt   DateTime @default(now()) @map("created_at")
}
